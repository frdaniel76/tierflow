# TierFlow Demo — VHS Tape
# Install vhs: brew install charmbracelet/tap/vhs
# Record:      vhs demo/demo.tape
# Output:      demo/tierflow-demo.gif

Output demo/tierflow-demo.gif

Set FontSize 14
Set Width 900
Set Height 500
Set Theme "Catppuccin Mocha"
Set Padding 20

Type "bash demo/record.sh"
Enter
Sleep 45s
